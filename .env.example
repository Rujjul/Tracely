# Local development only. Keep DATABASE_URL in sync with the values below.
POSTGRES_USER=tracely
POSTGRES_PASSWORD=tracely_local_dev
POSTGRES_DB=tracely
# Port 5432 is already occupied on this machine.
POSTGRES_PORT=5433
DATABASE_URL=postgresql://tracely:tracely_local_dev@127.0.0.1:5433/tracely
FRONTEND_URL=http://127.0.0.1:5173
# Set true when serving over HTTPS.
COOKIE_SECURE=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/google/callback
# Password reset delivery (use provider SMTP credentials, never a Google OAuth secret).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Phase 7 worker (run separately from FastAPI).
DETECTOR_WINDOW_SECONDS=300
DETECTOR_INTERVAL_SECONDS=30
DETECTOR_MIN_REQUESTS=20
DETECTOR_MIN_FAILURES=5
DETECTOR_TRIGGER_RATE=0.10
DETECTOR_RESOLVE_RATE=0.05
